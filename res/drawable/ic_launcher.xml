<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#212121" />
        </shape>
    </item>
    <item>
        <inset android:insetLeft="12dp" android:insetRight="12dp"
               android:insetTop="20dp" android:insetBottom="20dp">
            <shape android:shape="rectangle">
                <solid android:color="#FFFFFF" />
                <corners android:radius="3dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="8dp" android:insetRight="8dp"
               android:insetTop="16dp" android:insetBottom="30dp">
            <shape android:shape="rectangle">
                <solid android:color="#212121" />
                <corners android:radius="2dp" />
            </shape>
        </inset>
    </item>
</layer-list>
